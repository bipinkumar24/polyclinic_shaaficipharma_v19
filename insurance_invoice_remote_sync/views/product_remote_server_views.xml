<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_remote_server_form_insurance_invoice" model="ir.ui.view">
        <field name="name">product.remote.server.form.insurance.invoice</field>
        <field name="model">product.remote.server</field>
        <field name="inherit_id" ref="hms_remote_sync.view_product_remote_server_form_hms"/>
        <field name="arch" type="xml">
            <button name="action_sync_hms_all" position="after">
                <button name="action_sync_insurance_invoice_test_batch" type="object"
                        string="Sync Insurance Invoice Test Batch" class="btn-secondary"/>
                <button name="action_sync_insurance_invoices" type="object"
                        string="Sync Insurance Invoices Now" class="btn-primary"/>
                <button name="action_validate_insurance_invoices" type="object"
                        string="Validate Insurance Invoices" class="btn-secondary"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_insurance_invoices" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="insurance_invoice_count" widget="statinfo"
                           string="Insurance Invoices"/>
                </button>
            </div>
            <xpath expr="//sheet" position="inside">
                <group string="Insurance Invoice Skip Log"
                       invisible="not insurance_invoice_skip_log">
                    <field name="insurance_invoice_skip_log" nolabel="1" readonly="1"/>
                </group>
                <group string="Insurance Invoice Validation Report"
                       invisible="not insurance_invoice_validation_report">
                    <field name="insurance_invoice_validation_report" nolabel="1" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
