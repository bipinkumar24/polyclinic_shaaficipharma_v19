<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="action_report_advance" model="ir.actions.report">
        <field name="name">Salary Advance Slip</field>
        <field name="model">payment.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">payment_request.report_advance_document</field>
        <field name="report_file">payment_request.report_advance_document</field>
        <field name="print_report_name">'Advance Slip - %s' % (object.name)</field>
        <field name="attachment_use" eval="False"/>
        <field name="binding_model_id" ref="model_payment_request"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_overtime" model="ir.actions.report">
        <field name="name">Overtime Payment Slip</field>
        <field name="model">payment.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">payment_request.report_overtime_document</field>
        <field name="report_file">payment_request.report_overtime_document</field>
        <field name="print_report_name">'Overtime Slip - %s' % (object.name)</field>
        <field name="attachment_use" eval="False"/>
        <field name="binding_model_id" ref="model_payment_request"/>
        <field name="binding_type">report</field>
    </record>

</data>
</odoo>
