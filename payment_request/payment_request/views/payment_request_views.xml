<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════
     REJECT WIZARD
══════════════════════════════════════════════════ -->
<record id="view_payment_request_reject_wizard_form" model="ir.ui.view">
    <field name="name">payment.request.reject.wizard.form</field>
    <field name="model">payment.request.reject.wizard</field>
    <field name="arch" type="xml">
        <form string="Reject Payment Request">
            <field name="request_id" invisible="1"/>
            <group>
                <div class="alert alert-warning" role="alert">
                    Please provide a clear reason for rejection.
                </div>
                <field name="rejection_reason" nolabel="1"
                       placeholder="State the reason for rejecting this payment request..."
                       style="min-height: 100px;"/>
            </group>
            <footer>
                <button name="action_confirm_reject" string="Confirm Rejection"
                        type="object" class="btn-danger"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>


<!-- ══════════════════════════════════════════════════
     FORM VIEW
══════════════════════════════════════════════════ -->
<record id="view_payment_request_form" model="ir.ui.view">
    <field name="name">payment.request.form</field>
    <field name="model">payment.request</field>
    <field name="arch" type="xml">
        <form string="Payment Request">
            <header>
                <button name="action_submit" string="Submit for Approval"
                        type="object" class="btn-primary"
                        invisible="not can_submit"
                        confirm="Submit this payment request for manager review?"/>
                <button name="action_review" string="Mark as Reviewed"
                        type="object" class="btn-primary"
                        invisible="not can_review"/>
                <button name="action_verify" string="Verify and Forward"
                        type="object" class="btn-primary"
                        invisible="not can_verify"/>
                <button name="action_approve" string="Final Approve"
                        type="object" class="btn-success"
                        invisible="not can_approve"
                        confirm="Approve this request and generate a vendor bill?"/>
                <button name="action_reject" string="Reject"
                        type="object" class="btn-danger"
                        invisible="not can_reject"/>
                <button name="action_cancel" string="Cancel"
                        type="object"
                        invisible="not can_cancel"/>
                <button name="action_reset_draft" string="Reset to Draft"
                        type="object"
                        invisible="state not in ('rejected','cancelled')"
                        groups="payment_request.group_payment_request_manager"/>
                <button name="action_print_report" string="Print Request"
                        type="object" icon="fa-print"
                        invisible="state == 'draft'"/>
                <button name="action_print_schedule" string="Print Schedule"
                        type="object" icon="fa-calendar"
                        invisible="request_type != 'loan' or state != 'approved'"/>
                <button name="action_print_advance_slip" string="Print Advance Slip"
                        type="object" icon="fa-file-text"
                        invisible="request_type != 'advance' or state == 'draft'"/>
                <button name="action_print_overtime_slip" string="Print Overtime Slip"
                        type="object" icon="fa-file-text"
                        invisible="request_type != 'overtime' or state == 'draft'"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,submitted,reviewed,verified,approved"/>
            </header>

            <sheet>
                <!-- Smart buttons -->
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_bill" type="object"
                            class="oe_stat_button" icon="fa-file-text-o"
                            invisible="bill_count == 0">
                        <field name="bill_count" widget="statinfo" string="Bill"/>
                    </button>
                    <button name="action_view_instalments" type="object"
                            class="oe_stat_button" icon="fa-calendar-check-o"
                            invisible="request_type != 'loan' or instalment_count == 0">
                        <div class="o_stat_info">
                            <field name="instalment_count" class="o_stat_value"/>
                            <span class="o_stat_text">Instalments</span>
                        </div>
                    </button>
                    <button name="action_view_instalments" type="object"
                            class="oe_stat_button" icon="fa-exclamation-circle"
                            invisible="instalments_overdue == 0">
                        <div class="o_stat_info">
                            <field name="instalments_overdue" class="o_stat_value" style="color:#dc3545"/>
                            <span class="o_stat_text">Overdue</span>
                        </div>
                    </button>
                </div>

                <!-- Rejection banner -->
                <div class="alert alert-danger" role="alert"
                     invisible="state != 'rejected'">
                    <strong>Rejected</strong> by
                    <field name="rejected_by" readonly="1" nolabel="1"/>
                    on <field name="date_rejected" readonly="1" nolabel="1"/>
                </div>

                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                </div>

                <group>
                    <group string="Request Info">
                        <field name="request_type" readonly="state != 'draft'"/>
                        <field name="employee_id" readonly="state != 'draft'"/>
                        <field name="department_id" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="date_request" readonly="state != 'draft'"/>
                        <field name="date_needed"/>
                        <field name="request_priority"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Financial">
                        <field name="amount_requested"
                               readonly="state != 'draft'" widget="monetary"/>
                        <field name="amount_approved" widget="monetary"
                               invisible="state not in ('reviewed','verified','approved')"/>
                        <field name="analytic_account_id"
                               readonly="state not in ('draft','submitted','reviewed','verified')"
                               groups="analytic.group_analytic_accounting"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>

                <group string="Description / Justification">
                    <field name="description" nolabel="1"
                           readonly="state != 'draft'"
                           placeholder="Describe the purpose and justification for this payment request..."/>
                </group>

                <notebook>

                    <!-- ═══ LOAN ═══ -->
                    <page string="Loan Application" invisible="request_type != 'loan'">
                        <group string="Loan Purpose">
                            <group>
                                <field name="loan_purpose" readonly="state != 'draft'"/>
                                <field name="loan_purpose_detail" readonly="state != 'draft'"
                                       placeholder="Provide additional details about the loan purpose..."/>
                            </group>
                            <group>
                                <field name="loan_existing_loans" widget="monetary"
                                       readonly="state != 'draft'"/>
                                <field name="loan_total_debt" widget="monetary" readonly="1"/>
                            </group>
                        </group>
                        <group string="Repayment Terms">
                            <group>
                                <field name="loan_repayment_method" readonly="state != 'draft'"/>
                                <field name="loan_repayment_months" readonly="state != 'draft'"/>
                                <field name="loan_first_deduction_date" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="loan_interest_rate" readonly="state != 'draft'"/>
                                <field name="loan_monthly_deduction" widget="monetary" readonly="1"/>
                                <field name="loan_total_repayable" widget="monetary" readonly="1"/>
                            </group>
                        </group>
                        <group string="Disbursement">
                            <group>
                                <field name="loan_disbursement_method" readonly="state != 'draft'"/>
                                <field name="loan_bank_account" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group string="Guarantor Information">
                            <group>
                                <field name="loan_guarantor" readonly="state != 'draft'"/>
                                <field name="loan_guarantor_id_no" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="loan_guarantor_phone" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group string="Collateral / Security">
                            <field name="loan_collateral" nolabel="1"
                                   readonly="state != 'draft'"
                                   placeholder="Describe any collateral or security offered..."/>
                        </group>
                        <group string="Declaration">
                            <field name="loan_terms_accepted" readonly="state != 'draft'"
                                   string="I accept the loan terms and authorize monthly salary deduction"/>
                        </group>
                    </page>

                    <!-- ═══ LOAN SCHEDULE ═══ -->
                    <page string="Instalment Schedule" invisible="request_type != 'loan'">
                        <group>
                            <group string="Loan Progress">
                                <field name="instalments_paid" readonly="1"/>
                                <field name="instalment_count" readonly="1" string="Total Instalments"/>
                                <field name="instalments_overdue" readonly="1"/>
                                <field name="loan_completion_pct" readonly="1" widget="progressbar"/>
                            </group>
                            <group string="Financial Summary">
                                <field name="amount_paid_total" readonly="1" widget="monetary"/>
                                <field name="amount_outstanding" readonly="1" widget="monetary"/>
                            </group>
                        </group>
                        <div class="o_row" style="margin-bottom:12px">
                            <button name="action_generate_instalments" type="object"
                                    string="Generate Instalment Schedule"
                                    class="btn-primary"
                                    invisible="state != 'approved' or instalment_count != 0"
                                    confirm="Generate instalment schedule? Existing schedule will be replaced."/>
                            <button name="action_generate_instalments" type="object"
                                    string="Regenerate Schedule"
                                    invisible="state != 'approved' or instalment_count == 0"
                                    confirm="Regenerate schedule? This will delete and recreate all instalments."/>
                            <button name="action_view_instalments" type="object"
                                    string="Open Full Schedule"
                                    class="btn-secondary"
                                    invisible="instalment_count == 0"/>
                        </div>
                        <field name="instalment_ids" readonly="state == 'draft'"
                               context="{'default_loan_id': id}">
                            <list editable="bottom"
                                  decoration-success="state == 'paid'"
                                  decoration-danger="state == 'overdue'"
                                  decoration-warning="state == 'due'"
                                  decoration-muted="state == 'waived'">
                                <field name="instalment_no" string="No." readonly="1"/>
                                <field name="due_date" readonly="1"/>
                                <field name="principal_amount" widget="monetary" readonly="1" string="Principal"/>
                                <field name="interest_amount" widget="monetary" readonly="1" string="Interest"/>
                                <field name="amount" widget="monetary" readonly="1" string="Instalment"/>
                                <field name="amount_paid" widget="monetary" string="Paid"/>
                                <field name="balance_after" widget="monetary" readonly="1" string="Balance"/>
                                <field name="state" readonly="1"/>
                                <field name="payment_date" optional="show"/>
                                <field name="payment_reference" optional="show"/>
                                <field name="currency_id" column_invisible="1"/>
                                <button name="action_mark_paid" string="Pay"
                                        type="object" icon="fa-check"
                                        invisible="state in ('paid','waived')"
                                        class="btn-sm btn-success"/>
                            </list>
                        </field>
                    </page>

                    <!-- ═══ ADVANCE ═══ -->
                    <page string="Advance Details" invisible="request_type != 'advance'">
                        <group>
                            <group>
                                <field name="advance_month" readonly="state != 'draft'"/>
                                <field name="advance_year" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="advance_percentage" readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </page>

                    <!-- ═══ OVERTIME ═══ -->
                    <page string="Overtime Details" invisible="request_type != 'overtime'">
                        <group>
                            <group>
                                <field name="overtime_date" readonly="state != 'draft'"/>
                                <field name="overtime_hours" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="overtime_rate" readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </page>

                    <!-- ═══ PURCHASE ═══ -->
                    <page string="Purchase Details" invisible="request_type != 'purchase'">
                        <group>
                            <group>
                                <field name="vendor_name" readonly="state != 'draft'"/>
                                <field name="po_reference" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <field name="purchase_line_ids" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="description" required="1"/>
                                <field name="quantity"/>
                                <field name="uom"/>
                                <field name="unit_price"/>
                                <field name="subtotal" readonly="1" widget="monetary"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer">
                            <field name="purchase_total" widget="monetary" readonly="1"/>
                        </group>
                    </page>

                    <!-- ═══ EXPENSE ═══ -->
                    <page string="Expense Details" invisible="request_type != 'expense'">
                        <group>
                            <group>
                                <field name="expense_category" readonly="state != 'draft'"/>
                                <field name="expense_period_from" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="expense_period_to" readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </page>

                    <!-- ═══ APPROVAL TRAIL ═══ -->
                    <page string="Approval Trail">
                        <group string="Manager Review">
                            <field name="reviewed_by" readonly="1"/>
                            <field name="date_reviewed" readonly="1"/>
                            <field name="manager_note"
                                   readonly="state != 'submitted'"
                                   placeholder="Manager review notes..."/>
                        </group>
                        <group string="Finance Verification">
                            <field name="verified_by" readonly="1"/>
                            <field name="date_verified" readonly="1"/>
                            <field name="finance_note"
                                   readonly="state != 'reviewed'"
                                   placeholder="Finance verification notes..."/>
                        </group>
                        <group string="Final Approval">
                            <field name="approved_by" readonly="1"/>
                            <field name="date_approved" readonly="1"/>
                            <field name="bill_id" readonly="1"/>
                            <field name="approver_note"
                                   readonly="state != 'verified'"
                                   placeholder="Approver notes..."/>
                        </group>
                        <group string="Rejection" invisible="state != 'rejected'">
                            <field name="rejected_by" readonly="1"/>
                            <field name="date_rejected" readonly="1"/>
                            <field name="rejection_reason" readonly="1"/>
                        </group>
                    </page>

                    <!-- ═══ DOCUMENTS ═══ -->
                    <page string="Documents">
                        <field name="attachment_ids" widget="many2many_binary"
                               string="Supporting Documents"/>
                    </page>

                </notebook>

                <!-- Hidden computed fields -->
                <field name="can_submit" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="can_verify" invisible="1"/>
                <field name="can_approve" invisible="1"/>
                <field name="can_reject" invisible="1"/>
                <field name="can_cancel" invisible="1"/>
                <field name="bill_count" invisible="1"/>
                <field name="instalment_count" invisible="1"/>
                <field name="instalments_overdue" invisible="1"/>
                <field name="instalments_paid" invisible="1"/>
                <field name="amount_paid_total" invisible="1"/>
                <field name="amount_outstanding" invisible="1"/>
                <field name="loan_completion_pct" invisible="1"/>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>


<!-- ══════════════════════════════════════════════════
     LIST VIEW
══════════════════════════════════════════════════ -->
<record id="view_payment_request_list" model="ir.ui.view">
    <field name="name">payment.request.list</field>
    <field name="model">payment.request</field>
    <field name="arch" type="xml">
        <list string="Payment Requests">
            <field name="name"/>
            <field name="request_type"/>
            <field name="employee_id"/>
            <field name="department_id"/>
            <field name="date_request"/>
            <field name="amount_requested" widget="monetary" sum="Total"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="state"/>
            <field name="bill_id" optional="show" string="Bill"/>
        </list>
    </field>
</record>


<!-- ══════════════════════════════════════════════════
     KANBAN VIEW
══════════════════════════════════════════════════ -->
<record id="view_payment_request_kanban" model="ir.ui.view">
    <field name="name">payment.request.kanban</field>
    <field name="model">payment.request</field>
    <field name="arch" type="xml">
        <kanban default_group_by="state" records_draggable="0">
            <field name="name"/>
            <field name="request_type"/>
            <field name="employee_id"/>
            <field name="amount_requested"/>
            <field name="currency_id"/>
            <field name="state"/>
            <field name="date_request"/>
            <templates>
                <t t-name="card">
                    <div class="o_kanban_record_top">
                        <div class="o_kanban_record_headings">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                        </div>
                    </div>
                    <div class="o_kanban_record_body">
                        <field name="request_type"/>
                        <div><field name="employee_id"/></div>
                        <div><strong><field name="amount_requested" widget="monetary"/></strong></div>
                        <div class="text-muted"><field name="date_request"/></div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>


<!-- ══════════════════════════════════════════════════
     PIVOT
══════════════════════════════════════════════════ -->
<record id="view_payment_request_pivot" model="ir.ui.view">
    <field name="name">payment.request.pivot</field>
    <field name="model">payment.request</field>
    <field name="arch" type="xml">
        <pivot string="Payment Requests Analysis">
            <field name="request_type" type="row"/>
            <field name="state" type="col"/>
            <field name="amount_requested" type="measure"/>
        </pivot>
    </field>
</record>


<!-- ══════════════════════════════════════════════════
     GRAPH
══════════════════════════════════════════════════ -->
<record id="view_payment_request_graph" model="ir.ui.view">
    <field name="name">payment.request.graph</field>
    <field name="model">payment.request</field>
    <field name="arch" type="xml">
        <graph string="Payment Requests" type="bar">
            <field name="request_type" type="row"/>
            <field name="amount_requested" type="measure"/>
        </graph>
    </field>
</record>


<!-- ══════════════════════════════════════════════════
     ACTIONS
══════════════════════════════════════════════════ -->

<record id="action_payment_request_all" model="ir.actions.act_window">
    <field name="name">All Payment Requests</field>
    <field name="res_model">payment.request</field>
    <field name="view_mode">list,kanban,form,pivot,graph</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No payment requests yet</p>
        <p>Create a new payment request for loans, advances, overtime, purchases or expenses.</p>
    </field>
</record>

<record id="action_payment_request_mine" model="ir.actions.act_window">
    <field name="name">My Payment Requests</field>
    <field name="res_model">payment.request</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('requested_by','=',uid)]</field>
    <field name="context">{'default_requested_by': uid}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No requests yet</p>
        <p>Submit your first payment request.</p>
    </field>
</record>

<record id="action_payment_request_to_review" model="ir.actions.act_window">
    <field name="name">To Review</field>
    <field name="res_model">payment.request</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[('state','=','submitted')]</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No requests pending review</p>
    </field>
</record>

<record id="action_payment_request_to_verify" model="ir.actions.act_window">
    <field name="name">To Verify</field>
    <field name="res_model">payment.request</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[('state','=','reviewed')]</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No requests pending verification</p>
    </field>
</record>

<record id="action_payment_request_to_approve" model="ir.actions.act_window">
    <field name="name">To Approve</field>
    <field name="res_model">payment.request</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[('state','=','verified')]</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No requests pending final approval</p>
    </field>
</record>

<record id="action_payment_request_approved" model="ir.actions.act_window">
    <field name="name">Approved Requests</field>
    <field name="res_model">payment.request</field>
    <field name="view_mode">list,pivot,graph,form</field>
    <field name="domain">[('state','=','approved')]</field>
</record>

</data>
</odoo>
