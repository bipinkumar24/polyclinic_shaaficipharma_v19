<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="view_payment_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.reject.wizard.form</field>
        <field name="model">payment.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Payment Request">
                <field name="request_id" invisible="1"/>
                <group>
                    <div class="alert alert-warning" role="alert">
                        Please provide a clear reason for rejection. The requester will be notified by email.
                    </div>
                    <field name="rejection_reason"
                           nolabel="1"
                           placeholder="State the reason for rejecting this payment request..."
                           style="min-height: 100px;"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data>
</odoo>
