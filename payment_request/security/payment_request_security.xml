<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Requester: can create and view own requests -->
        <record id="group_payment_request_user" model="res.groups">
            <field name="name">Payment Request / Requester</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Department Manager: can review submitted requests -->
        <record id="group_payment_request_manager" model="res.groups">
            <field name="name">Payment Request / Department Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
        </record>

        <!-- Finance Officer: can verify reviewed requests -->
        <record id="group_payment_request_finance" model="res.groups">
            <field name="name">Payment Request / Finance Officer</field>
            <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
        </record>

        <!-- GM Approver: can give final approval -->
        <record id="group_payment_request_approver" model="res.groups">
            <field name="name">Payment Request / GM Approver</field>
            <field name="implied_ids" eval="[(4, ref('group_payment_request_manager'))]"/>
        </record>

        <!-- Administrator: full access -->
        <record id="group_payment_request_admin" model="res.groups">
            <field name="name">Payment Request / Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_payment_request_approver')), (4, ref('group_payment_request_finance'))]"/>
        </record>

    </data>
</odoo>
