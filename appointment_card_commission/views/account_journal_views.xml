<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_appointment_commission" model="ir.ui.view">
        <field name="name">account.journal.form.appointment.commission</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="is_appointment_commission_journal"/>
            </xpath>
        </field>
    </record>
</odoo>
